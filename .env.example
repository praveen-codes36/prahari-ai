# Copy this file to .env (in the relevant module folder) and fill in real values.
# NEVER commit the actual .env file — it's already in .gitignore.

# ---------------- Backend (FastAPI/Node) ----------------
DATABASE_URL=postgresql://username:password@localhost:5432/prahari_db
# or for MongoDB:
# MONGODB_URI=mongodb://localhost:27017/prahari_db

PORT=8000
SECRET_KEY=replace-with-a-long-random-string

# ---------------- Frontend ----------------
VITE_API_BASE_URL=http://localhost:8000

# ---------------- External APIs ----------------
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
GEOCODING_API_KEY=your_opencage_or_nominatim_key_here
MAPBOX_TOKEN=your_mapbox_token_here

# ---------------- ML Model ----------------
MODEL_PATH=./ml-model/checkpoints/risk_model.pkl
CNN_MODEL_PATH=./ml-model/checkpoints/defect_classifier.pt

# ---------------- Routing Engine ----------------
CITY_NAME=Prayagraj, India
OSM_GRAPH_CACHE_PATH=./routing-engine/cache/road_graph.graphml
